# La pantalla de los ojos, al arrancar la Raspberry (P11).
#
# Es un servicio DE USUARIO (no de sistema): necesita el escritorio para poder
# abrir la ventana. Se instala asi, en la Raspberry:
#
#   mkdir -p ~/.config/systemd/user
#   cp ~/telmeow/raspberry/telmeow-ojos.service ~/.config/systemd/user/
#   nano ~/.config/systemd/user/telmeow-ojos.service    # poner la IP de la PC
#   systemctl --user daemon-reload
#   systemctl --user enable --now telmeow-ojos
#
# Ver que hace:    journalctl --user -u telmeow-ojos -f
# Pararla:         systemctl --user stop telmeow-ojos
#
# Restart=always: si el programa muriera, systemd lo vuelve a lanzar a los 2 s
# y vuelve a pintar la expresion del siguiente mensaje de pose (llegan 20 por
# segundo).

[Unit]
Description=Telmeow - la pantalla de los ojos
After=graphical-session.target network-online.target
PartOf=graphical-session.target

[Service]
# CAMBIAR: la IP de la PC del narrador (donde corre Mosquitto).
Environment=TELMEOW_MQTT_HOST=192.168.1.50
# --display: el numero de la pantalla de los ojos (la DSI de 5 pulgadas). Cual
# es el 0 y cual el 1 depende de la Raspberry: probar con --windowed primero.
ExecStart=%h/telmeow/venv/bin/python %h/telmeow/raspberry/eye_display.py --display 1
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
